# name: test/sql/storage/attach_read_only.test
# description: Test attaching in read only mode
# group: [storage]

require postgres_scanner

require-env POSTGRES_TEST_DATABASE_AVAILABLE

statement ok
PRAGMA enable_verification

statement ok
ATTACH 'dbname=postgresscanner' AS s (TYPE POSTGRES, READ_ONLY)

statement error
CREATE TABLE s.read_only_tbl(i INTEGER);
----
read-only mode

statement error
CALL postgres_execute('s', 'CREATE UNLOGGED TABLE public.my_unlogged_table(i INTEGER)')
----
read-only

statement ok
DETACH s

# Keep the DuckDB catalog read-only while omitting READ ONLY from the remote
# transaction for PostgreSQL-compatible servers that reject the modifier.
statement ok
ATTACH 'dbname=postgresscanner' AS s (TYPE POSTGRES, READ_ONLY, TRANSACTION_READ_ONLY false)

query T
CALL postgres_query('s', 'SELECT current_setting(''transaction_read_only'')')
----
off

statement error
CREATE TABLE s.still_read_only_tbl(i INTEGER);
----
read-only mode
